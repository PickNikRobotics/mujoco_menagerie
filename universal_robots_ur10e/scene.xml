<mujoco model="ur10e scene">

  <include file="ur10e.xml"/>

  <statistic center="0.4 0 0.4" extent="1"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" pos="0 0 -0.5" size="0 0 0.05" type="plane" material="groundplane"/>
    <body name="box" pos="-1.2 -0.55 0">
      <freejoint />
      <!-- Control tracks well with 10 kg box welded -->
      <!-- Increasing to 15kg (beyond the payload of the 10e) results in poor tracking -->
      <geom
        type="box"
        size="0.147 0.2435 0.385"
        mass="10"
      />
    </body>

  </worldbody>

  <!-- Start with weld activated -->
  <equality>
    <weld
      name="attachment"
      body1="wrist_3_link"
      body2="box"
      active="true"
      torquescale="5"
    />
  </equality>
</mujoco>
